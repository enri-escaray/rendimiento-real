# Rendimiento Real — variables de entorno (plantilla, sin secretos)
# Copiá este archivo a .env.local y completá los valores. .env.local NO se sube a git.

# Neon (Postgres serverless). Cadena de conexión con pooling.
# Sin esto, la app funciona en modo "cache en memoria" (los datos se refrescan
# por request/cron pero no persisten entre despliegues). Ver /lib/db.
DATABASE_URL=

# Secreto para proteger el endpoint de cron (/api/cron/actualizar).
# Vercel Cron envía este valor en el header Authorization.
CRON_SECRET=
